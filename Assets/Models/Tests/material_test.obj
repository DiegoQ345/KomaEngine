# Prueba de materiales importados: dos piezas, dos materiales
mtllib material_test.mtl

o Part_Red
usemtl Material_Red
v -1.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v -1.5  0.5 -0.5
v -1.5 -0.5  0.5
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -1.5  0.5  0.5
f 1 4 3 2
f 5 6 7 8
f 1 5 8 4
f 2 3 7 6
f 1 2 6 5
f 4 8 7 3

o Part_Textured
usemtl Material_Textured
v 0.5 -0.5 -0.5
v 1.5 -0.5 -0.5
v 1.5  0.5 -0.5
v 0.5  0.5 -0.5
v 0.5 -0.5  0.5
v 1.5 -0.5  0.5
v 1.5  0.5  0.5
v 0.5  0.5  0.5
